{
  "expo": {
    "name": "Rika",
    "slug": "rika-app",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b0f10",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/rika-logo-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f10"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f10"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.chromet.roxarika",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "pwa": {
        "name": "Rika",
        "short_name": "Rika",
        "description": "Smart Financial Management for Couples",
        "themeColor": "#0b0f10",
        "backgroundColor": "#0b0f10",
        "display": "standalone",
        "orientation": "portrait"
      }
    },
    "plugins": [
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "125376b6-f1e1-46b7-ad0b-09b9a43c2b86"
      }
    },
    "owner": "chrometcrosley"
  }
}
